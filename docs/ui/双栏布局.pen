        {
          "type": "text",
          "id": "DlQa7",
          "name": "档位与浮层约束说明",
          "fill": "$muted-foreground",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "档位顺序：关闭、最低、低、中、高、极高、最大；仅展示当前模型已配置的档位\n粒子从右向左流动，数量、密度与流速均随推理强度逐档增加\n每轮时长：最低 4 秒、低 3 秒、中 2.2 秒、高 1.6 秒、极高 1.1 秒、最大 0.75 秒\n粒子数量：0、3、6、10、15、21、28；切换强度时保持流动连续\n被覆盖的档位节点隐藏；关闭、隐藏及减少动态效果时停止粒子\n可交互预览：thinking-slider-preview.html；拖动跟手、松开吸附，过渡沿用共享 200ms",
          "lineHeight": 1.5,
          "fontFamily": "$font-sans",
          "fontSize": "$text-ui-small",
          "fontWeight": "normal"
        }
      ]
