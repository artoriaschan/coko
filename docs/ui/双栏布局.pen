        {
          "type": "text",
          "id": "PF0jr",
          "name": "删除确认规则",
          "fill": "$muted-foreground",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "搜索示例标题仅用“示例对话 · A01 / B02”等中性占位名称\n独立、项目内、置顶及搜索结果中的对话项可右键打开同一更多菜单，禁止浏览器原生菜单\n右键不切换会话，菜单位置由鼠标坐标决定；点击更多仍遵循行右侧 2px 规则\n点击删除对话只打开确认弹窗，尚未删除；取消、关闭或 Escape 保留数据\n确认后永久删除目标对话及其子智能体对话，无法撤销；提交失败保留数据并提示",
          "lineHeight": 1.5,
          "fontFamily": "$font-sans",
          "fontSize": "$text-ui-small",
          "fontWeight": "normal"
        }
      ]
