          "layoutPosition": "absolute",
          "x": 0,
          "y": 0,
          "name": "桌面应用 · 双栏工作台 · superellipse(1.5) 表面",
          "metadata": {
            "type": "design-system-surface",
            "curve": "superellipse(1.5)",
            "radiusToken": "$radius-panel",
