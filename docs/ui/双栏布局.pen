        {
          "type": "text",
          "id": "CBxWD",
          "name": "共享规则",
          "fill": "$muted-foreground",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "纵向宽 4px，横向高 4px；两端半圆 R2，保持圆弧，不随 hover / 拖动加粗\n透明轨道与交角，无上下 / 左右箭头；滑块长度按可见区域比例，短内容不额外展示滚动条\n主题与状态颜色由共享 token 维护；端部间距 2px，避免顶住容器圆角\n沿用既有隐藏标题滚动条的约定；滚轮、触控板、拖动及键盘滚动仍正常工作",
          "lineHeight": 1.5,
          "fontFamily": "$font-sans",
          "fontSize": "$text-ui-small",
          "fontWeight": "normal"
        }
      ]
    },
