{
  "name": "coko",
  "private": true,
  "type": "module",
  "scripts": {
    "build:desktop": "pnpm --filter @coko/desktop run build",
    "check:docs": "node scripts/check-docs.ts",
    "dev:desktop": "pnpm --filter @coko/desktop run start",
    "eval": "vitest run --project evals",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "make:desktop": "pnpm --filter @coko/desktop run make",
    "package:desktop": "pnpm --filter @coko/desktop run package",
    "postinstall": "node scripts/postinstall-node-pty.mjs",
    "prepare": "husky",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@coko/protocol": "workspace:*",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "@vscode/ripgrep": "1.18.0",
    "electron": "41.0.3",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "mdast-util-from-markdown": "2.1.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typebox": "1.3.27",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.3",
    "ws": "8.22.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,tsx,jsx}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint"
    ],
    "*.{json,jsonc,yaml,yml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@12.15.0"
}
